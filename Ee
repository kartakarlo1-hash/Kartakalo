<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>KARTAKALO — Nokia Edition</title>
<style>
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:#000;color:#d8ae39;font-family:"Courier New",monospace}
body{display:flex;justify-content:center;align-items:center;padding:14px}
.phone{width:min(405px,96vw);padding:18px 16px 24px;border-radius:42px;background:linear-gradient(145deg,#242424 0%,#090909 28%,#151515 55%,#050505 100%);border:3px solid #343434;box-shadow:inset 2px 2px 0 #555,inset -3px -3px 0 #000,0 35px 90px #000;position:relative}
.phone:before{content:"";position:absolute;left:9px;right:9px;top:9px;bottom:9px;border:1px solid #171717;border-radius:35px;pointer-events:none}
.speaker{width:92px;height:9px;margin:2px auto 10px;border-radius:10px;background:#020202;box-shadow:inset 0 2px 3px #555,0 1px 0 #333}
.brand{text-align:center;font-weight:1000;letter-spacing:6px;font-size:16px;color:#e1b53e;text-shadow:0 0 14px rgba(225,181,62,.18);margin-bottom:11px}
.screenFrame{padding:11px;border-radius:22px;background:#050505;border:2px solid #292929;box-shadow:inset 0 0 0 1px #555,0 5px 12px #000}
.screen{height:570px;border-radius:12px;overflow:hidden;background:#070907;position:relative;border:1px solid #1e1e1e;background-image:repeating-linear-gradient(0deg,rgba(225,181,62,.055) 0,rgba(225,181,62,.055) 1px,transparent 1px,transparent 4px)}
.status{height:34px;padding:8px 10px;border-bottom:1px solid #4a3814;background:#090909;display:flex;justify-content:space-between;font-size:11px;font-weight:900;color:#dfb33c}
.page{display:none;height:calc(100% - 34px);padding:16px 13px;overflow:auto}
.page.active{display:block}
.gold{color:#dfb33c;font-size:10px;font-weight:1000;letter-spacing:3px}
h1{font-size:31px;line-height:.95;margin:8px 0 15px;color:#dfb33c}
h2{font-size:23px;margin:7px 0 13px;color:#dfb33c}
p{font-size:12px;line-height:1.55;color:#aaa}
.hero{height:235px;display:flex;align-items:center;justify-content:center}
.hero img{width:94%;height:100%;object-fit:contain;filter:drop-shadow(0 0 14px rgba(223,179,60,.15))}
.menu{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.menu button,.actionBtn{min-height:58px;background:linear-gradient(#171717,#090909);border:1px solid #574515;border-radius:5px;color:#dfb33c;font:1000 11px "Courier New";cursor:pointer;box-shadow:inset 0 1px 0 #333,0 2px 0 #000}
.menu button:active,.actionBtn:active,.key:active{transform:translateY(2px);box-shadow:none}
.icon{font-size:20px;display:block;margin-bottom:4px}
.card{border:1px solid #443611;background:#0b0b0b;padding:11px;border-radius:4px;margin:8px 0}
.product{display:grid;grid-template-columns:68px 1fr;gap:9px;align-items:center}
.product img{width:68px;height:75px;object-fit:contain}
.product h3{margin:0 0 4px;color:#eee;font-size:12px}
.price{color:#dfb33c;font-weight:1000;font-size:12px}
.actionBtn{min-height:auto;padding:8px;width:100%;margin-top:6px}
input,textarea{width:100%;background:#050505;border:1px solid #4b3a15;color:#eee;padding:9px;font:12px "Courier New";border-radius:3px;margin:3px 0 7px}
textarea{height:72px;resize:none}
label{font-size:10px;color:#888}
.notice{border:1px dashed #594617;background:#0a0a0a;padding:9px;color:#aaa;font-size:10px;line-height:1.5;margin:8px 0}
.back{margin-top:11px;color:#dfb33c;font-size:11px;font-weight:1000;cursor:pointer}
.cartRow,.total{display:flex;justify-content:space-between;gap:5px;font-size:11px;color:#ccc;margin:5px 0}
.total{border-top:1px solid #443611;padding-top:8px;color:#dfb33c;font-weight:1000}
.game{height:400px;border:2px solid #493913;background:#09110a}
canvas{display:block;width:100%;height:100%;image-rendering:pixelated}
.controls{display:grid;grid-template-columns:repeat(3,48px);gap:5px;justify-content:center;margin-top:7px}
.controls button{height:35px;background:linear-gradient(#1a1a1a,#080808);border:1px solid #584516;color:#dfb33c;font:1000 17px "Courier New";border-radius:5px}
.empty{visibility:hidden}
.gameActions{display:flex;gap:6px;margin-top:7px}
.gameActions button{flex:1;padding:8px;background:#121212;border:1px solid #594617;color:#dfb33c;font:1000 10px "Courier New";border-radius:4px}
.keypad{padding:15px 8px 0}
.softkeys{display:grid;grid-template-columns:1fr 1fr;gap:95px;margin-bottom:7px}
.softkeys button{height:29px;border-radius:9px;background:linear-gradient(#333,#101010);border:1px solid #555;color:#d9d9d9;font:1000 9px "Courier New";box-shadow:inset 0 2px 0 #555,0 3px 0 #000;cursor:pointer}
.navpad{display:grid;grid-template-columns:58px 82px 58px;grid-template-rows:30px 39px 30px;justify-content:center;align-items:center;gap:3px;margin-bottom:8px}
.navpad button{border:1px solid #555;background:linear-gradient(#2e2e2e,#0b0b0b);color:#ddd;font:1000 14px "Courier New";cursor:pointer;box-shadow:inset 0 2px 0 #555,0 3px 0 #000}
.navpad .up{grid-column:2;border-radius:14px 14px 5px 5px}
.navpad .left{grid-column:1;grid-row:2;border-radius:14px 5px 5px 14px}
.navpad .ok{grid-column:2;grid-row:2;border-radius:50%;background:linear-gradient(#c79b2d,#5e4613);color:#050505;border-color:#8e6b1d}
.navpad .right{grid-column:3;grid-row:2;border-radius:5px 14px 14px 5px}
.navpad .down{grid-column:2;grid-row:3;border-radius:5px 5px 14px 14px}
.numberpad{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;max-width:265px;margin:auto}
.key{height:41px;border-radius:12px;background:linear-gradient(155deg,#303030,#101010 70%);border:1px solid #555;color:#eee;box-shadow:inset 0 2px 0 #5a5a5a,0 4px 0 #000;cursor:pointer;text-align:center;font-family:"Courier New";font-weight:1000;font-size:15px}
.key span{display:block;color:#888;font-size:7px;letter-spacing:1px;margin-top:1px}
.key.goldKey{color:#dfb33c}
.footerBrand{text-align:center;color:#555047;font-size:12px;font-weight:1000;letter-spacing:6px;margin-top:13px}
@media(max-height:760px){.screen{height:500px}.hero{height:205px}}
</style>

<style>
.highscore-box{margin:10px 0;padding:10px;border:1px solid #b78b24;background:#080808;color:#d8ad36;font-family:monospace}
.hs-title{font-weight:900;margin-bottom:7px}
.hs-row{display:grid;grid-template-columns:32px 1fr auto;gap:6px;padding:4px 0;border-bottom:1px dotted #5f4815}
.hs-empty{font-size:11px;opacity:.8}
#highscoreForm{margin-top:10px}
#highscoreForm label{display:block;font-size:10px;margin-bottom:4px}
#highscoreForm input{width:100%;box-sizing:border-box;background:#111;color:#fff;border:1px solid #b78b24;padding:9px;font-family:monospace;font-size:16px}
#highscoreForm button{margin-top:7px;width:100%;padding:10px;background:#b78b24;color:#050505;border:0;font-weight:900;font-family:monospace;cursor:pointer}
</style>
</head>
