<script>
const pages=document.querySelectorAll('.page');
function go(id){pages.forEach(p=>p.classList.toggle('active',p.id===id))}
document.querySelectorAll('[data-go]').forEach(x=>x.onclick=()=>go(x.dataset.go));
setInterval(()=>{const d=new Date();clock.textContent=d.toLocaleTimeString('de-DE',{hour:'2-digit',minute:'2-digit'})},1000);
clock.textContent=new Date().toLocaleTimeString('de-DE',{hour:'2-digit',minute:'2-digit'});

let cart=[];
function add(name,price){cart.push({name,price});renderCart();go('order')}
function renderCart(){
 cartItems.innerHTML=cart.length?cart.map((x,i)=>`<div class="cartRow"><span>${x.name}</span><span>${x.price.toFixed(2).replace('.',',')} € <button onclick="cart.splice(${i},1);renderCart()" style="background:none;border:0;color:#dfb33c">×</button></span></div>`).join(''):'<p style="color:#666">Warenkorb leer.</p>';
 total.textContent=cart.reduce((s,x)=>s+x.price,0).toFixed(2).replace('.',',')+' €';
}
renderCart();
orderForm.onsubmit=e=>{e.preventDefault();if(!cart.length){alert('Warenkorb ist leer.');go('shop');return}orderMsg.style.display='block';orderMsg.innerHTML='<b>✓ BESTELLUNG VORBEREITET</b><br>Demo-Bestellung für '+oname.value+' wurde erfasst.'};
contactForm.onsubmit=e=>{e.preventDefault();contactMsg.style.display='block';contactMsg.innerHTML='<b>✓ NACHRICHT VORBEREITET</b><br>Für echten Versand muss später ein Mail-Backend angeschlossen werden.'};

const c=document.getElementById('gameCanvas'),ctx=c.getContext('2d'),img=new Image();img.src='data:image/png;base64,';
let run=false,pause=false,time=30,score=0,last=0,me={x:45,y:200},k={x:270,y:200,vx:75,vy:60},keys={up:0,down:0,left:0,right:0},pts=[];
function start(){run=true;pause=false;time=30;score=0;me={x:45,y:200};k={x:270,y:200,vx:75,vy:60};pts=[]}
startGame.onclick=start;pauseGame.onclick=()=>pause=!pause;
addEventListener('keydown',e=>{let z=e.key.toLowerCase();if(z==='arrowup'||z==='w')keys.up=1;if(z==='arrowdown'||z==='s')keys.down=1;if(z==='arrowleft'||z==='a')keys.left=1;if(z==='arrowright'||z==='d')keys.right=1});
addEventListener('keyup',e=>{let z=e.key.toLowerCase();if(z==='arrowup'||z==='w')keys.up=0;if(z==='arrowdown'||z==='s')keys.down=0;if(z==='arrowleft'||z==='a')keys.left=0;if(z==='arrowright'||z==='d')keys.right=0});
document.querySelectorAll('[data-dir]').forEach(b=>{let d=b.dataset.dir;b.onpointerdown=e=>{e.preventDefault();keys[d]=1};b.onpointerup=()=>keys[d]=0;b.onpointerleave=()=>keys[d]=0;b.onpointercancel=()=>keys[d]=0});
function burst(x,y){for(let i=0;i<14;i++)pts.push({x,y,vx:(Math.random()-.5)*100,vy:(Math.random()-.5)*100,l:1})}
function update(dt){
 if(!run||pause)return;
 let dx=keys.right-keys.left,dy=keys.down-keys.up,L=Math.hypot(dx,dy)||1;
 me.x+=dx/L*180*dt;me.y+=dy/L*180*dt;me.x=Math.max(12,Math.min(308,me.x));me.y=Math.max(28,Math.min(372,me.y));
 k.x+=k.vx*dt;k.y+=k.vy*dt;if(k.x<35||k.x>285)k.vx*=-1;if(k.y<42||k.y>365)k.vy*=-1;
 if(Math.hypot(me.x-k.x,me.y-k.y)<27){score++;burst(k.x,k.y);k.x=40+Math.random()*240;k.y=50+Math.random()*310}
 time-=dt;if(time<=0){time=0;run=false}pts.forEach(x=>{x.x+=x.vx*dt;x.y+=x.vy*dt;x.l-=dt*2});pts=pts.filter(x=>x.l>0);
}
function draw(){
 ctx.fillStyle='#071007';ctx.fillRect(0,0,320,400);ctx.strokeStyle='#1d3a21';
 for(let x=0;x<320;x+=16){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,400);ctx.stroke()}for(let y=0;y<400;y+=16){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(320,y);ctx.stroke()}
 ctx.fillStyle='#dfb33c';ctx.font='bold 11px monospace';ctx.fillText('SCORE '+score,7,16);ctx.fillText('TIME '+Math.ceil(time),250,16);
 if(img.complete)ctx.drawImage(img,k.x-24,k.y-33,48,66);
 ctx.fillStyle='#dfb33c';ctx.fillRect(me.x-5,me.y-5,10,10);ctx.fillStyle='#000';ctx.fillRect(me.x-2,me.y-2,4,4);
 pts.forEach(x=>{ctx.globalAlpha=x.l;ctx.fillStyle='#dfb33c';ctx.fillRect(x.x,x.y,3,3)});ctx.globalAlpha=1;
 if(!run){ctx.fillStyle='rgba(0,0,0,.65)';ctx.fillRect(0,0,320,400);ctx.textAlign='center';ctx.fillStyle='#dfb33c';ctx.font='bold 20px monospace';ctx.fillText(time===0?'GAME OVER':'KARTAKALO CHASE',160,190);ctx.fillStyle='#fff';ctx.font='bold 11px monospace';ctx.fillText('START drücken',160,215);ctx.textAlign='left'}
 if(pause){ctx.fillStyle='rgba(0,0,0,.6)';ctx.fillRect(0,0,320,400);ctx.textAlign='center';ctx.fillStyle='#dfb33c';ctx.font='bold 20px monospace';ctx.fillText('PAUSE',160,205);ctx.textAlign='left'}
}
function loop(ts){let dt=Math.min(.04,(ts-last)/1000||0);last=ts;update(dt);draw();requestAnimationFrame(loop)}draw();requestAnimationFrame(loop);

/* KARTAKALO ntfy contact notifications */
(function(){
  const form = document.querySelector('#contact form') || document.querySelector('form[data-contact]');
  if(!form) return;

  form.addEventListener('submit', async function(e){
    e.preventDefault();

    const fd = new FormData(form);
    const name = (fd.get('name') || fd.get('Name') || '').trim();
    const what = (fd.get('what') || fd.get('wunsch') || fd.get('request') || '').trim();
    const where = (fd.get('where') || fd.get('ort') || fd.get('location') || '').trim();
    const when = (fd.get('when') || fd.get('wann') || fd.get('date') || '').trim();
    const how = (fd.get('how') || fd.get('details') || fd.get('message') || '').trim();

    const status = document.getElementById('contactStatus');

    if(!name || !what || !where || !when || !how){
      if(status) status.textContent = 'BITTE ALLE FELDER AUSFÜLLEN.';
      return;
    }

    const message =
`🔔 NEUE KARTAKALO ANFRAGE

Name: ${name}
Was: ${what}
Wo: ${where}
Wann: ${when}
Wie genau: ${how}`;

    if(status) status.textContent = 'WIRD AN NTFY GESENDET...';

    try{
      const response = await fetch('https://ntfy.sh/kartakalo_bestellungen_8472', {
        method: 'POST',
        headers: {
          'Content-Type': 'text/plain; charset=utf-8',
          'Title': 'Neue KARTAKALO Anfrage',
          'Priority': 'high',
          'Tags': 'kartakalo,shopping'
        },
        body: message
      });

      if(!response.ok) throw new Error('ntfy failed');

      if(status) status.textContent = '✓ GESENDET — KARTAKALO MELDET SICH.';
      form.reset();
    }catch(error){
      console.error(error);
      if(status) status.textContent = '✕ SENDEN FEHLGESCHLAGEN — BITTE ERNEUT VERSUCHEN.';
    }
  });
})();




/* KARTAKALO CHASE + HIGHSCORE */
(function(){
  const canvas=document.querySelector('#gameCanvas');
  if(!canvas) return;
  const ctx=canvas.getContext('2d');
  const scoreEl=document.querySelector('#gameScore');
  const timeEl=document.querySelector('#gameTime');
  const statusEl=document.querySelector('#gameStatus');
  const startBtn=document.querySelector('#gameStart');
  const form=document.querySelector('#highscoreForm');
  const nameInput=document.querySelector('#highscoreName');
  const list=document.querySelector('#highscoreList');
  const tableWrap=document.querySelector('#highscoreBox');

  const W=canvas.width||240,H=canvas.height||180;
  let player={x:W/2-12,y:H-30,w:24,h:24,speed:4};
  let items=[],score=0,time=30,running=false,last=0,spawn=0,raf=0,gameEnded=false;
  const keys={left:false,right:false};
  let highscore=readScores();

  function readScores(){
    try{return JSON.parse(localStorage.getItem('kartakalo_highscores')||'[]').filter(x=>x&&typeof x.name==='string'&&Number.isFinite(x.score)).slice(0,10)}
    catch(e){return []}
  }
  function saveScores(){
    try{localStorage.setItem('kartakalo_highscores',JSON.stringify(highscore))}
    catch(e){}
  }
  function renderScores(){
    if(!list) return;
    if(!highscore.length){
      list.innerHTML='<div class="hs-empty">NOCH KEINE SCORES — SEI DER ERSTE!</div>';
      return;
    }
    list.innerHTML=highscore.map((x,i)=>`<div class="hs-row"><b>${i+1}.</b><span>${escapeHtml(x.name)}</span><strong>${x.score}</strong></div>`).join('');
  }
  function escapeHtml(s){
    return s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }
  function submitScore(){
    if(!gameEnded) return;
    const name=(nameInput?.value||'KARTA').trim().slice(0,16)||'KARTA';
    highscore.push({name,score:Math.max(0,Math.floor(score))});
    highscore.sort((a,b)=>b.score-a.score);
    highscore=highscore.slice(0,10);
    saveScores(); renderScores();
    if(form) form.hidden=true;
    statusEl.textContent='🏆 SCORE GESPEICHERT — TOP 10';
  }
  function spawnItem(){
    const r=Math.random();
    const type=r<.18?'bomb':r<.31?'knife':r<.40?'trash':'money';
    items.push({type,x:8+Math.random()*(W-24),y:-22,w:22,h:22,vy:1.6+Math.random()*1.8});
  }
  function hit(a,b){return a.x<b.x+b.w&&a.x+a.w>b.x&&a.y<b.y+b.h&&a.y+a.h>b.y}
  function endGame(msg){
    running=false; gameEnded=true;
    statusEl.textContent=msg+' — SCORE: '+score;
    if(form) form.hidden=false;
  }
  function update(dt){
    if(!running)return;
    if(keys.left)player.x-=player.speed;
    if(keys.right)player.x+=player.speed;
    player.x=Math.max(2,Math.min(W-player.w-2,player.x));
    spawn+=dt;
    if(spawn>520){spawn=0;spawnItem()}
    items.forEach(it=>it.y+=it.vy*(dt/16));
    for(const it of items){
      if(!it.dead&&hit(player,it)){
        it.dead=true;
        if(it.type==='money')score+=100;
        else{
          endGame(it.type==='bomb'?'💥 BOMBE! GAME OVER':it.type==='knife'?'🔪 MESSER! GAME OVER':'💥 HINDERNIS! GAME OVER');
          break;
        }
      }
    }
    items=items.filter(it=>!it.dead&&it.y<H+25);
    if(!running)return;
    time-=dt/1000;
    if(time<=0){time=0;endGame('⏱️ ZEIT ABGELAUFEN')}
    scoreEl.textContent=String(score).padStart(5,'0');
    timeEl.textContent=time.toFixed(1);
  }
  function draw(){
    ctx.clearRect(0,0,W,H);ctx.fillStyle='#050505';ctx.fillRect(0,0,W,H);
    ctx.strokeStyle='rgba(255,210,70,.10)';
    for(let y=0;y<H;y+=8){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke()}
    ctx.fillStyle='#d8ad36';ctx.fillRect(player.x+6,player.y,12,8);
    ctx.fillStyle='#111';ctx.fillRect(player.x+3,player.y+7,18,13);
    ctx.fillStyle='#fff';ctx.fillRect(player.x+6,player.y+9,5,3);ctx.fillRect(player.x+14,player.y+9,5,3);
    ctx.fillStyle='#d8ad36';ctx.fillRect(player.x+4,player.y+20,6,4);ctx.fillRect(player.x+14,player.y+20,6,4);
    for(const it of items){
      const x=it.x,y=it.y;
      if(it.type==='money'){
        ctx.fillStyle='#e1b83e';ctx.fillRect(x,y+3,22,16);ctx.strokeStyle='#000';ctx.strokeRect(x+1,y+4,20,14);
        ctx.fillStyle='#111';ctx.font='13px monospace';ctx.textAlign='center';ctx.fillText('$',x+11,y+15);
      }else if(it.type==='bomb'){
        ctx.fillStyle='#151515';ctx.beginPath();ctx.arc(x+11,y+12,9,0,Math.PI*2);ctx.fill();
        ctx.fillStyle='#e1b83e';ctx.fillRect(x+9,y,5,5);ctx.strokeStyle='#e1b83e';ctx.beginPath();ctx.moveTo(x+12,y+1);ctx.lineTo(x+17,y-5);ctx.stroke();
      }else if(it.type==='knife'){
        ctx.fillStyle='#ccc';ctx.beginPath();ctx.moveTo(x+3,y+17);ctx.lineTo(x+17,y+3);ctx.lineTo(x+20,y+6);ctx.lineTo(x+6,y+20);ctx.closePath();ctx.fill();
        ctx.fillStyle='#8a5b2a';ctx.fillRect(x+1,y+16,7,5);
      }else{
        ctx.fillStyle='#777';ctx.fillRect(x+4,y+4,14,16);ctx.fillStyle='#222';ctx.fillRect(x+6,y+2,10,4);
      }
    }
    ctx.fillStyle='#d8ad36';ctx.font='10px monospace';ctx.textAlign='left';ctx.fillText('GELD = +100',5,12);
  }
  function loop(ts){
    const dt=last?Math.min(50,ts-last):16;last=ts;update(dt);draw();
    if(running)raf=requestAnimationFrame(loop);
  }
  function start(){
    cancelAnimationFrame(raf);score=0;time=30;items=[];running=true;gameEnded=false;last=0;spawn=0;
    player.x=W/2-player.w/2;scoreEl.textContent='00000';timeEl.textContent='30.0';
    if(form)form.hidden=true;
    statusEl.textContent='SAMMLE NUR GELD! BOMBE/MESSER = GAME OVER';
    raf=requestAnimationFrame(loop);
  }
  startBtn?.addEventListener('click',start);
  form?.addEventListener('submit',e=>{e.preventDefault();submitScore()});
  document.querySelectorAll('[data-game-left]').forEach(b=>{
    b.addEventListener('pointerdown',()=>keys.left=true);['pointerup','pointercancel','pointerleave'].forEach(ev=>b.addEventListener(ev,()=>keys.left=false));
  });
  document.querySelectorAll('[data-game-right]').forEach(b=>{
    b.addEventListener('pointerdown',()=>keys.right=true);['pointerup','pointercancel','pointerleave'].forEach(ev=>b.addEventListener(ev,()=>keys.right=false));
  });
  window.addEventListener('keydown',e=>{
    if(e.key==='ArrowLeft'||e.key.toLowerCase()==='a')keys.left=true;
    if(e.key==='ArrowRight'||e.key.toLowerCase()==='d')keys.right=true;
    if(e.key===' '&&!running)start();
  });
  window.addEventListener('keyup',e=>{
    if(e.key==='ArrowLeft'||e.key.toLowerCase()==='a')keys.left=false;
    if(e.key==='ArrowRight'||e.key.toLowerCase()==='d')keys.right=false;
  });
  renderScores();draw();
})();

</script>
</body>
</html>
